    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#f2f3f8",
      "dark": "#0a0c14"
    }
  },
  "fonts": {
