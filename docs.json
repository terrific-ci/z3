{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "z3",
  "description": "S3-compatible object storage in one binary: erasure coding, active-active replication, IAM, encryption and a web console.",
  "colors": {
    "primary": "#4b55d6",
    "light": "#a6b0ff",
    "dark": "#4b55d6"
  },
  "favicon": "/favicon.svg",
